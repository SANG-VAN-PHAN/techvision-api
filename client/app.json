{
  "name": "TechVisionApp",
  "slug": "techvision-app",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "light",
  "scheme": "techvision",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#0066FF"
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "vn.techvision.app",
    "infoPlist": {
      "CFBundleURLSchemes": ["techvision"],
      "LSApplicationQueriesSchemes": ["fbapi", "fb-messenger-share-api", "fbauth2", "fbshareextension"],
      "NSCameraUsageDescription": "TechVision cần quyền camera để chụp ảnh sản phẩm",
      "NSPhotoLibraryUsageDescription": "TechVision cần quyền truy cập ảnh để tải lên"
    }
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#0066FF"
    },
    "package": "vn.techvision.app",
    "permissions": [
      "CAMERA",
      "READ_EXTERNAL_STORAGE",
      "WRITE_EXTERNAL_STORAGE"
    ],
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "techvision"
          }
        ],
        "category": ["BROWSABLE", "DEFAULT"]
      }
    ]
  },
  "web": {
    "favicon": "./assets/favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-router",
    [
      "expo-google-sign-in",
      {
        "clientId": "YOUR_GOOGLE_CLIENT_ID"
      }
    ],
    [
      "expo-facebook",
      {
        "appId": "YOUR_FACEBOOK_APP_ID",
        "appName": "TechVision"
      }
    ],
    [
      "expo-build-properties",
      {
        "ios": {
          "useFrameworks": "static"
        }
      }
    ],
    "expo-secure-store"
  ],
  "extra": {
    "eas": {
      "projectId": "techvision-ecommerce"
    }
  },
  "runtimeVersion": {
    "policy": "sdkVersion"
  }
}
